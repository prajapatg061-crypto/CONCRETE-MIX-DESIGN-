<script>
// Global Database for Excel Export
let trialDatabase = [];

function calculateReverseMix() {
  const trialName = document.getElementById('trialName').value || "Reverse Audit Trial";
  
  // 1. Material Weights Input (kg)
  const wCement = parseFloat(document.getElementById('wCement').value || 0);
  const scmType = document.getElementById('scmType').value;
  const wSCM = scmType !== 'none' ? parseFloat(document.getElementById('wSCM').value || 0) : 0;
  const wWater = parseFloat(document.getElementById('wWater').value || 0);
  const wFA = parseFloat(document.getElementById('wFA').value || 0);
  const wCA20 = parseFloat(document.getElementById('wCA20').value || 0);
  const wCA10 = parseFloat(document.getElementById('wCA10').value || 0);
  const wAdmix = parseFloat(document.getElementById('wAdmix').value || 0);

  // 2. Specific Gravities & Parameters
  const sgCement = parseFloat(document.getElementById('sgCement').value || 3.15);
  const sgSCM = parseFloat(document.getElementById('sgSCM').value || 2.20);
  const sgFA = parseFloat(document.getElementById('sgFA').value || 2.65);
  const sgCA20 = parseFloat(document.getElementById('sgCA20').value || 2.74);
  const sgCA10 = parseFloat(document.getElementById('sgCA10').value || 2.72);
  const sgAdmix = parseFloat(document.getElementById('sgAdmix').value || 1.08);
  const airPct = parseFloat(document.getElementById('airContent').value || 1.0) / 100;
  const admixWaterRed = parseFloat(document.getElementById('admixEfficiency').value || 20);

  // 3. Material Rates
  const rCement = parseFloat(document.getElementById('costCement').value || 0);
  const rSCM = parseFloat(document.getElementById('costSCM').value || 0);
  const rWater = parseFloat(document.getElementById('costWater').value || 0);
  const rFA = parseFloat(document.getElementById('costFA').value || 0);
  const rCA20 = parseFloat(document.getElementById('costCA20').value || 0);
  const rCA10 = parseFloat(document.getElementById('costCA10').value || 0);
  const rAdmix = parseFloat(document.getElementById('costAdmix').value || 0);

  // Total Mass of Inputs
  const totalMassInput = wCement + wSCM + wWater + wFA + wCA20 + wCA10 + wAdmix;

  // 4. Volumetric Calculations (m3)
  const volCement = wCement / (sgCement * 1000);
  const volSCM = wSCM > 0 ? wSCM / (sgSCM * 1000) : 0;
  const volWater = wWater / 1000;
  const volFA = wFA / (sgFA * 1000);
  const volCA20 = wCA20 / (sgCA20 * 1000);
  const volCA10 = wCA10 / (sgCA10 * 1000);
  const volAdmix = wAdmix / (sgAdmix * 1000);

  // Total Solid + Fluid Volume
  const absoluteVolume = volCement + volSCM + volWater + volFA + volCA20 + volCA10 + volAdmix;
  
  // Total Volume including Air
  const totalYield = absoluteVolume / (1.0 - airPct);

  // 5. Calculate Fresh Wet Density (kg/m3)
  const wetDensity = totalMassInput / totalYield;

  // Normalized Weights per 1.0 m3
  const normCement = wCement / totalYield;
  const normSCM = wSCM / totalYield;
  const normWater = wWater / totalYield;
  const normFA = wFA / totalYield;
  const normCA20 = wCA20 / totalYield;
  const normCA10 = wCA10 / totalYield;
  const normAdmix = wAdmix / totalYield;
  const totalBinderNorm = normCement + normSCM;

  // 6. Water-Binder Ratio & Strength (fck) Back-Calculation
  const wbRatio = normWater / totalBinderNorm;
  
  // Effective W/B adjusting for Fly Ash/GGBS efficiency (Poitevin / IS 10262 approach)
  let kFactor = scmType === 'flyash' ? 0.8 : (scmType === 'ggbs' ? 0.9 : 1.0);
  let effectiveWB = normWater / (normCement + (kFactor * normSCM));

  // Projected 28-day Target Mean Strength f'ck (N/mm2) via empirical Abram's relationship
  let f_prime_ck = 12 + (13.5 / Math.pow(effectiveWB, 1.45));
  
  // Estimate Characteristic Strength fck = f'ck - 1.65*S
  let S = f_prime_ck >= 35 ? 5.0 : 4.0;
  let fck = f_prime_ck - (1.65 * S);
  if (fck < 15) fck = 15;

  // 7. Slump / Workability Estimation (mm)
  // Base slump calculated from water per m3 and Admixture %
  let baseWaterRequirement = 186 * (1 - (admixWaterRed / 100));
  let waterRatio = normWater / baseWaterRequirement;
  let admixPctOfBinder = (normAdmix / totalBinderNorm) * 100;

  let estSlump = 50 + (waterRatio - 1.0) * 150 + (admixPctOfBinder * 35);
  if (estSlump < 25) estSlump = 25;
  if (estSlump > 220) estSlump = 220;

  let slumpDisplay = Math.round(estSlump) + " mm";
  if (estSlump >= 160) slumpDisplay += " (Self-Compacting / Flow)";

  // 8. Cost Analysis
  const cCement = normCement * rCement;
  const cSCM = normSCM * rSCM;
  const cWater = normWater * rWater;
  const cFA = normFA * rFA;
  const cCA20 = normCA20 * rCA20;
  const cCA10 = normCA10 * rCA10;
  const cAdmix = normAdmix * rAdmix;

  const totalCost = cCement + cSCM + cWater + cFA + cCA20 + cCA10 + cAdmix;

  const binderCostPct = (((cCement + cSCM) / totalCost) * 100).toFixed(1);
  const aggCostPct = (((cFA + cCA20 + cCA10) / totalCost) * 100).toFixed(1);
  const admixCostPct = ((cAdmix / totalCost) * 100).toFixed(1);

  // Update UI Results
  document.getElementById('outHeaderTrialName').innerText = trialName;
  document.getElementById('outYield').innerText = totalYield.toFixed(3) + " m³";
  document.getElementById('outDensity').innerText = Math.round(wetDensity) + " kg/m³";
  document.getElementById('outFck').innerText = "M" + Math.round(fck) + " (" + fck.toFixed(1) + " N/mm²)";
  document.getElementById('outFckMean').innerText = f_prime_ck.toFixed(1) + " N/mm²";
  document.getElementById('outSlump').innerText = slumpDisplay;
  document.getElementById('outWB').innerText = wbRatio.toFixed(2);

  // Input & Normalized Table Values
  document.getElementById('outCementInput').innerText = wCement.toFixed(1);
  document.getElementById('outCementNorm').innerText = normCement.toFixed(1);
  document.getElementById('rateCement').innerText = rCement.toFixed(2);
  document.getElementById('costCementTotal').innerText = cCement.toFixed(2);

  document.getElementById('outSCMInput').innerText = wSCM.toFixed(1);
  document.getElementById('outSCMNorm').innerText = normSCM.toFixed(1);
  document.getElementById('rateSCM').innerText = rSCM.toFixed(2);
  document.getElementById('costSCMTotal').innerText = cSCM.toFixed(2);

  document.getElementById('outWaterInput').innerText = wWater.toFixed(1);
  document.getElementById('outWaterNorm').innerText = normWater.toFixed(1);
  document.getElementById('rateWater').innerText = rWater.toFixed(2);
  document.getElementById('costWaterTotal').innerText = cWater.toFixed(2);

  document.getElementById('outFAInput').innerText = wFA.toFixed(1);
  document.getElementById('outFANorm').innerText = normFA.toFixed(1);
  document.getElementById('rateFA').innerText = rFA.toFixed(2);
  document.getElementById('costFATotal').innerText = cFA.toFixed(2);

  document.getElementById('outCA20Input').innerText = wCA20.toFixed(1);
  document.getElementById('outCA20Norm').innerText = normCA20.toFixed(1);
  document.getElementById('rateCA20').innerText = rCA20.toFixed(2);
  document.getElementById('costCA20Total').innerText = cCA20.toFixed(2);

  document.getElementById('outCA10Input').innerText = wCA10.toFixed(1);
  document.getElementById('outCA10Norm').innerText = normCA10.toFixed(1);
  document.getElementById('rateCA10').innerText = rCA10.toFixed(2);
  document.getElementById('costCA10Total').innerText = cCA10.toFixed(2);

  document.getElementById('outAdmixInput').innerText = wAdmix.toFixed(2);
  document.getElementById('outAdmixNorm').innerText = normAdmix.toFixed(2);
  document.getElementById('rateAdmix').innerText = rAdmix.toFixed(2);
  document.getElementById('costAdmixTotal').innerText = cAdmix.toFixed(2);

  // Cost Summary
  document.getElementById('outTotalCost').innerText = totalCost.toFixed(2);
  document.getElementById('outBinderCostPct').innerText = binderCostPct;
  document.getElementById('outAggCostPct').innerText = aggCostPct;
  document.getElementById('outAdmixCostPct').innerText = admixCostPct;

  // Toggle SCM Row
  const scmRow = document.getElementById('scmRow');
  if (scmType === 'none') {
    scmRow.style.display = 'none';
  } else {
    scmRow.style.display = 'table-row';
    document.getElementById('outScmName').innerText = scmType === 'flyash' ? 'Fly Ash' : 'GGBS';
  }

  document.getElementById('resultsCard').style.display = 'block';

  // --- EXCEL LOGGING ---
  const currentTimestamp = new Date().toLocaleString();
  const trialRecord = {
    "Timestamp": currentTimestamp,
    "Audit Trial Name": trialName,
    "Calculated Yield (m3)": totalYield.toFixed(3),
    "Wet Density (kg/m3)": Math.round(wetDensity),
    "Est. fck (N/mm2)": fck.toFixed(1),
    "Est. Mean Str (N/mm2)": f_prime_ck.toFixed(1),
    "Est. Slump (mm)": Math.round(estSlump),
    "W/B Ratio": wbRatio.toFixed(2),
    "Cement per m3 (kg)": normCement.toFixed(1),
    "SCM per m3 (kg)": normSCM.toFixed(1),
    "Water per m3 (kg)": normWater.toFixed(1),
    "Sand per m3 (kg)": normFA.toFixed(1),
    "CA 20mm per m3 (kg)": normCA20.toFixed(1),
    "CA 10mm per m3 (kg)": normCA10.toFixed(1),
    "Admix per m3 (kg)": normAdmix.toFixed(2),
    "Total Cost (₹/m3)": totalCost.toFixed(2)
  };

  trialDatabase.push(trialRecord);
}

// Download Excel Function
function downloadExcelLog() {
  if (trialDatabase.length === 0) {
    alert("No reverse audit trials recorded yet. Click 'Run Reverse Calculation' first.");
    return;
  }

  const worksheet = XLSX.utils.json_to_sheet(trialDatabase);
  const workbook = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(workbook, worksheet, "Reverse Mix Audits");

  const max_width = trialDatabase.reduce((w, r) => Math.max(w, r["Audit Trial Name"].length), 10);
  worksheet["!cols"] = [ { wch: 20 }, { wch: max_width + 5 } ];

  XLSX.writeFile(workbook, "Reverse_Concrete_Mix_Audits_Log.xlsx");
}
</script>

